<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <app.holst.CanvasView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Часы не перехватывают касания: рисовать можно и под ними. -->
    <LinearLayout
        android:id="@+id/clock_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextClock
            style="@style/LockShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textSize="76sp" />

        <TextClock
            style="@style/LockShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/friend_chip"
            style="@style/LockShadowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/friend_drawing"
            android:textSize="13sp"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="108dp"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/colors_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/sizes_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clear_all"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:drawablePadding="6dp"
                android:gravity="center_vertical|end"
                android:paddingHorizontal="10dp"
                android:text="@string/clear_all"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <app.holst.ColorDot
            android:id="@+id/current_dot"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/brush" />

        <app.holst.UnlockHandle
            android:id="@+id/handle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/lock_mode"
            android:layout_width="46dp"
            android:layout_height="52dp"
            android:clickable="true"
            android:contentDescription="@string/lock_button"
            android:focusable="true"
            android:paddingHorizontal="11dp"
            android:paddingVertical="14dp"
            android:src="@drawable/ic_lock_open" />

        <ImageView
            android:id="@+id/undo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clickable="true"
            android:contentDescription="@string/undo"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_undo" />
    </LinearLayout>
</FrameLayout>
