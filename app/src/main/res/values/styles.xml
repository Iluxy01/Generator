<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Holst" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/marker</item>
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorPrimaryDark">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>

    <style name="Theme.Holst.Layer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sheet</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Muted">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="BtnPrimary">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#17140A</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnSecondary">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PermRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="PermLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textSize">14.5sp</item>
    </style>

    <style name="PermButton" parent="BtnSecondary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:minWidth">104dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="LockShadowText">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">8</item>
    </style>
</resources>
